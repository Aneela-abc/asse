# Copy this file to .env and fill in real values before running in production.
# The app works fully offline/without any keys — LLM summaries fall back to a
# deterministic rule-based summary and email falls back to an in-app "demo mode"
# notification log when these are not set.

# Used to hash passwords. Change this to a long random string.
APP_SECRET=change-this-in-production

# Optional: OpenAI-compatible LLM endpoint for pre-visit / post-visit AI summaries.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: SMTP for real email delivery. Without these, notifications are still
# queued, logged, and shown in-app ("Notifications" tab) so the whole workflow
# can be demonstrated without a real mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Optional: Google Calendar OAuth 2.0. Without these, the app still gives every
# patient/doctor a downloadable .ics calendar invite for each appointment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the deployed Streamlit app URL (Google redirects back here
# with ?code=...&state=...). Example: https://your-app.streamlit.app
GOOGLE_REDIRECT_URI=

# Optional: override the SQLite file location.
DB_PATH=data/healthcare.db
